{
	"name": "@aabeborn/rules",
	"version": "0.1.4",
	"description": "My personal linting and formatting rules",
	"type": "module",
	"private": false,
	"exports": {
		"./prettier": "./formatter/prettier.js",
		"./eslint/base": "./linter/eslint/base.js",
		"./eslint/react": "./linter/eslint/react.js",
		"./eslint/next": "./linter/eslint/next.js"
	},
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint ."
	},
	"files": [
		"package.json",
		"Readme.md",
		"formatter",
		"linter"
	],
	"keywords": [
		"ESLint",
		"Prettier",
		"formatting",
		"linting"
	],
	"author": "Andrea Benato",
	"license": "MIT",
